# Copy to .env (never commit .env). Server-only: none of these may reach frontend code. Plan §1.3, §3.1.
# Supabase project (same values the Edge Functions use)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (Dashboard > Connect). Pooler URLs work: prepared statements are off.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=10
# Seconds to wait for a free pooled connection (also the connect timeout)
DB_POOL_TIMEOUT=10
# Per-statement limit in ms (0 = none)
DB_STATEMENT_TIMEOUT_MS=15000
# Comma-separated browser origins. Empty = no browser origin allowed.
CORS_ALLOWED_ORIGINS=
# Shared secret for jobs-runner (min 32 chars). Unset = jobs-runner refuses all calls.
JOBS_RUNNER_SECRET=
# Timeout for calls to Supabase Auth, in seconds
AUTH_HTTP_TIMEOUT=10
# Retries on connect errors only (a sent request is never repeated)
AUTH_HTTP_RETRIES=1
# Largest accepted request body, in bytes
MAX_BODY_BYTES=1000000
LOG_LEVEL=info
