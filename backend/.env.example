# Copy to .env (never commit .env). Server-only values must never reach frontend code. See BACKEND_PLAN.md §3.1.
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Local/CI database URL used by db:apply, db:seed, db:test, codegen (from `supabase status -o env`)
DB_URL=
# Backups (CI only; provider not chosen yet)
BACKUP_DB_URL=
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
# Security
CORS_ALLOWED_ORIGINS=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
# Ops: local | staging | production
APP_ENV=local
LOG_LEVEL=info
JOBS_RUNNER_SECRET=
